{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.invalid/schemas/finding-event.schema.json",
  "title": "SENTINEL privacy-safe finding event record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "findingClass",
    "defectKind",
    "diagnosticCode",
    "findingToken",
    "fingerprintKind",
    "fingerprintVersion",
    "value",
    "observationSource"
  ],
  "properties": {
    "event": {
      "enum": [
        "detected",
        "persisted",
        "resolved",
        "reopened"
      ]
    },
    "findingClass": {
      "enum": [
        "projectCode",
        "projectTest",
        "projectCodeOrTest",
        "backend",
        "sentinel",
        "environment"
      ]
    },
    "defectKind": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
    },
    "diagnosticCode": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
    },
    "findingToken": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fingerprintKind": {
      "enum": [
        "occurrence",
        "context",
        "family"
      ]
    },
    "fingerprintVersion": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observationSource": {
      "const": "fresh"
    }
  }
}
